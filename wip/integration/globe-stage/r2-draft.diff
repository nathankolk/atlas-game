+  // After a drop the globe shows the whole miss: the city, and the pin too
+  // when one view can hold both. The view it turned from is kept, to go
+  // back to for the next city.
+  function showPinMiss(guess, truth) {
+    const g = map.globe, view = g.getView(), c = map.clear, edge = 40;
+    const inSight = lonlat => {
+      const p = g.project(lonlat);
+      return p.z > 0.35 && p.x >= c.left + edge && p.x <= c.right - edge && p.y >= c.top + edge && p.y <= c.bottom - edge;
+    };
+    const apart = guess ? d3.geoDistance(guess, truth) : 0;
+    const both = !!guess && apart < 2.1;            // under about 120°: one view shows both ends
+    g.invalidate();
+    if (inSight(truth) && (!both || inSight(guess))) return;
+    let to = { lon: truth[0], lat: truth[1], k: view.k };
+    if (both) {
+      // Centred between the two, each end lies sin(half the miss) globe radii out
+      const mid = d3.geoInterpolate(guess, truth)(0.5);
+      const room = Math.min(c.right - c.left, c.bottom - c.top) / 2 - edge;
+      const k = room / (Math.max(Math.sin(apart / 2), 0.05) * g.radiusPx() / view.k);
+      to = { lon: mid[0], lat: mid[1], k: Math.min(view.k, k) };
+    }
+    state.pin.back = view;
+    g.flyTo(to, { duration: reducedMotion() ? 0 : 550 });
+  }
